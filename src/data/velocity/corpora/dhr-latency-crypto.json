    "metric": "Years from publication of a final cryptographic specification (RFC or NIST FIPS) to the first stable OpenSSL release supporting the named feature.",
    "valueNoun": "specification to first stable OpenSSL release",
    "unitNoun": "transitions",
    "trendVerb": "shows faster adoption of sampled specifications in OpenSSL",
    "provenanceQuery": "reference implementation: OpenSSL; final RFC/FIPS publication → first stable release supporting the named feature",
    "splitYear": 2017,
