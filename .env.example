# Website editing/publishing is GitHub-only. No login, session secret, JWK,
# ATProto app password, or admin allowlist is needed for builds/runtime.
# Historical /neuro-atlas links redirect to the public PL Neuro site.

# Google Analytics 4 Measurement ID. Empty disables Google Analytics.
NEXT_PUBLIC_GA_ID=

# Analytics cookie-consent banner (on by default). "off" hides the banner
# and loads analytics directly. This is unrelated to retired login sessions.
NEXT_PUBLIC_COOKIE_CONSENT=on

# Public publication discovery is read from src/data/site-content/publication.json.
# No deployment variable or website credential is needed for it.

# Optional read-only metric token; no website CMS/publishing credentials.
# METACULUS_API_TOKEN=
